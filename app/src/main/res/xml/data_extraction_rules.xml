<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and later. Keep in step with backup_rules.xml.
    An include list: the learner's progress and settings only. The content database is rebuilt from
    the APK, and its file name changes with every content revision, which an exclude rule cannot match.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="progress.db" />
        <include domain="database" path="progress.db-wal" />
        <include domain="file" path="datastore/goal_prefs.preferences_pb" />
        <include domain="file" path="datastore/reminder_prefs.preferences_pb" />
        <include domain="file" path="datastore/onboarding_prefs.preferences_pb" />
        <include domain="file" path="datastore/settings_prefs.preferences_pb" />
        <include domain="file" path="datastore/lesson_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="progress.db" />
        <include domain="database" path="progress.db-wal" />
        <include domain="file" path="datastore/goal_prefs.preferences_pb" />
        <include domain="file" path="datastore/reminder_prefs.preferences_pb" />
        <include domain="file" path="datastore/onboarding_prefs.preferences_pb" />
        <include domain="file" path="datastore/settings_prefs.preferences_pb" />
        <include domain="file" path="datastore/lesson_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>

    <plurals name="home_block_review_size">
        <item quantity="one"><xliff:g id="count" example="1">%1$d</xliff:g> card, about <xliff:g id="minutes" example="1">%2$d</xliff:g> min</item>
        <item quantity="other"><xliff:g id="count" example="12">%1$d</xliff:g> cards, about <xliff:g id="minutes" example="6">%2$d</xliff:g> min</item>
    </plurals>
    <string name="home_block_review_done">Done for today</string>
    <string name="home_block_lesson_detail"><xliff:g id="unit" example="Greetings">%1$s</xliff:g>, about <xliff:g id="minutes" example="12">%2$d</xliff:g> min</string>

    <string name="home_continue">Continue</string>
    <string name="home_start_first_lesson">Start the first lesson</string>

    <string name="home_week_title">This week</string>
    <string name="home_streak"><xliff:g id="days" example="3">%1$d</xliff:g>-day streak</string>
    <plurals name="home_week_description">
        <item quantity="one">Studied <xliff:g id="days" example="1">%d</xliff:g> day this week</item>
        <item quantity="other">Studied <xliff:g id="days" example="3">%d</xliff:g> days this week</item>
    </plurals>

    <string name="home_error_title">Couldn’t make today’s plan</string>

<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- "ko" when the app shows Korean. Picks the language of content text such as lesson titles. -->
    <string name="home_content_language">en</string>

    <string name="home_title">Today</string>

<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="onboarding_progress"><xliff:g id="step" example="2">%1$d</xliff:g>/<xliff:g id="count" example="7">%2$d</xliff:g></string>
    <string name="onboarding_progress_description"><xliff:g id="count" example="7">%2$d</xliff:g>단계 중 <xliff:g id="step" example="2">%1$d</xliff:g>단계</string>
    <string name="onboarding_next">다음</string>
    <string name="onboarding_method_done">확인</string>
    <string name="onboarding_continue">계속</string>

    <string name="onboarding_welcome_title">길에 오신 걸 환영해요</string>
    <string name="onboarding_welcome_body">소리에서 문장까지 영어를 한 단계씩 익혀요. 먼저 공부하는 법을 짧게 보고 하루 목표를 정해요.</string>
    <string name="onboarding_welcome_start">시작하기</string>
    <string name="onboarding_welcome_skip">건너뛰기</string>

    <string name="onboarding_method_daily_title">매일 조금씩</string>
    <string name="onboarding_method_daily_body">일주일에 한 번 한 시간보다 매일 10분이 더 오래 남아요. 수업은 몇 분씩 나뉘어 있어서 언제 멈춰도 그 자리에서 이어서 할 수 있어요.</string>
    <string name="onboarding_method_review_title">복습은 앱이 챙겨요</string>
    <string name="onboarding_method_review_body">배운 단어와 문장은 잊어 갈 때쯤 다시 나와요. 무엇을 언제 복습할지는 앱이 정해서 오늘의 길에 모아 둬요.</string>
    <string name="onboarding_method_sound_title">소리 먼저, 소리 내서</string>
    <string name="onboarding_method_sound_body">수업은 늘 듣기로 시작해요. 들은 문장은 소리 내어 따라 말해 보세요. 귀와 입이 같이 익숙해져요.</string>
    <string name="onboarding_method_mistakes_title">틀려도 괜찮아요</string>
    <string name="onboarding_method_mistakes_body">틀렸다고 점수를 깎지 않아요. 틀린 문제는 나중에 복습할 때 다시 나오니 그때 한 번 더 풀면 돼요.</string>

    <string name="onboarding_goal_title">하루에 얼마나 공부할까요?</string>
    <string name="onboarding_goal_body">꾸준히 할 수 있는 시간을 골라 주세요. 짧아도 매일 하면 충분해요.</string>
    <string name="onboarding_goal_minutes"><xliff:g id="minutes" example="20">%d</xliff:g>분</string>
    <string name="onboarding_goal_10_detail">복습과 짧은 연습</string>
    <string name="onboarding_goal_20_detail">수업 하나와 복습</string>
    <string name="onboarding_goal_30_detail">수업 한두 개와 복습</string>
    <string name="onboarding_goal_60_detail">수업 여러 개와 복습</string>

    <string name="onboarding_reminder_title">언제 알려 드릴까요?</string>
    <string name="onboarding_reminder_body">하루에 두 번까지 정할 수 있어요. 오늘 목표를 이미 채운 날에는 알리지 않아요.</string>
    <string name="onboarding_reminder_change_time">시각 바꾸기</string>
    <string name="onboarding_reminder_remove"><xliff:g id="time" example="오후 8:00">%s</xliff:g> 알림 지우기</string>
    <string name="onboarding_reminder_add">시각 추가</string>
    <string name="onboarding_reminder_enable">알림 받기</string>
    <string name="onboarding_reminder_skip">알림 없이 계속</string>
    <string name="onboarding_reminder_picker_title">알림 시각</string>
    <string name="onboarding_reminder_picker_confirm">확인</string>
    <string name="onboarding_reminder_picker_cancel">취소</string>
    <string name="onboarding_reminder_rationale_title">알림을 허용해 주세요</string>
    <string name="onboarding_reminder_rationale_body">정한 시각에 알려 드리려면 알림 권한이 필요해요. 이어서 나오는 창에서 허용을 눌러 주세요.</string>
    <string name="onboarding_reminder_denied_title">알림 없이 시작할게요</string>
    <string name="onboarding_reminder_denied_body">알림이 없어도 앱을 열면 오늘 할 공부를 볼 수 있어요.</string>
    <string name="onboarding_reminder_blocked_title">알림이 꺼져 있어요</string>
    <string name="onboarding_reminder_blocked_body">알림을 받으려면 휴대폰 설정에서 이 앱의 알림을 허용해 주세요.</string>
    <string name="onboarding_reminder_open_settings">설정 열기</string>

    <string name="onboarding_sound_title">소리가 들리나요?</string>
    <string name="onboarding_sound_body">볼륨을 켜고 들어 보세요.</string>
    <string name="onboarding_sound_checking">소리를 준비하고 있어요</string>
    <string name="onboarding_sound_play_again">다시 듣기</string>
    <string name="onboarding_sound_heard">들려요</string>
    <string name="onboarding_sound_not_heard">안 들려요</string>
    <string name="onboarding_sound_not_heard_title">소리가 안 들려요</string>
    <string name="onboarding_sound_not_heard_body">휴대폰 볼륨과 무음 모드를 확인해 보세요. 그래도 안 들리면 영어 음성 데이터를 설치해야 할 수 있어요.</string>
    <string name="onboarding_sound_no_voice_title">아직 영어 음성이 없어요</string>
    <string name="onboarding_sound_no_voice_body">휴대폰에 영어 음성 데이터를 설치하면 들을 수 있어요. 설치하지 않아도 글로 공부할 수 있어요.</string>
    <string name="onboarding_sound_no_engine_title">이 휴대폰에서는 소리를 낼 수 없어요</string>
    <string name="onboarding_sound_no_engine_body">음성 엔진이 없어서 듣기 문제는 글로 바뀌어 나와요.</string>
    <string name="onboarding_sound_install">음성 데이터 설치</string>
    <string name="onboarding_sound_install_unavailable">음성 설정을 열지 못했어요. 휴대폰 설정에서 텍스트 음성 변환을 찾아 보세요.</string>
    <string name="onboarding_sound_continue_without">소리 없이 계속</string>
</resources>

    <string name="listening_no_voice_title">영어 음성이 없어요</string>
    <string name="listening_no_voice_body">듣기 모드는 휴대폰의 영어 음성으로 읽어 줘요. 영어 음성 데이터를 설치하면 쓸 수 있어요.</string>
    <string name="listening_no_engine_title">아직 소리를 낼 수 없어요</string>
    <string name="listening_no_engine_body">듣기 모드에는 음성 엔진이 필요한데 이 휴대폰에는 없어요.</string>

    <string name="listening_error_title">들을 것을 불러오지 못했어요</string>
    <string name="listening_error_body">수업이나 학습 기록을 읽지 못했어요.</string>
    <string name="listening_error_retry">다시 시도</string>

    <string name="listening_message_load_failed">들을 것을 불러오지 못했어요.</string>
    <string name="listening_message_render_failed">소리를 만들지 못했어요. 다시 시도해 주세요.</string>
    <string name="listening_message_voice_missing">필요한 음성 데이터가 없어서 소리를 만들지 못했어요.</string>
    <string name="listening_message_play_failed">재생을 시작하지 못했어요.</string>
    <string name="listening_message_playback_failed">재생이 멈췄어요. 다시 고르면 소리를 새로 만들어요.</string>

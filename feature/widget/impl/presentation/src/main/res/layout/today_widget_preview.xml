<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows from Android 12: a made-up day laid out as TodayWidgetLayout draws one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:paddingHorizontal="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_review_title"
            android:textColor="@color/widget_preview_ink"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_preview_count"
            android:textColor="@color/widget_preview_ink_blue"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- RemoteViews takes no plain View. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_preview_rule" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="serif"
        android:maxLines="2"
        android:text="@string/widget_preview_sentence"
        android:textColor="@color/widget_preview_ink"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:text="@string/widget_preview_sentence_ko"
        android:textColor="@color/widget_preview_ink_soft"
        android:textSize="14sp" />
</LinearLayout>

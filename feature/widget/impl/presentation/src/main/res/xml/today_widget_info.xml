<?xml version="1.0" encoding="utf-8"?>
<!-- About 3 by 2 cells to start, 4 by 2 where the launcher reads target cells (Android 12 and later);
     down to one row tall. The preview layout is also read from Android 12; before it the picker shows the icon. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_today_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:previewLayout="@layout/today_widget_preview"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
